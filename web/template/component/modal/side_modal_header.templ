package template

templ SideModalHeader(title string) {
    <header class="flex items-center text-xl font-semibold px-6 py-4" @click="$dispatch('toggle-modal')">
        <button @click="open = false" class="p-2 rounded-lg hover:bg-gray-200 active:bg-gray-300 duration-150">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <span class="ml-3">{ title }</span>
    </header>
}