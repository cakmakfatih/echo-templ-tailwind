package template

templ MainLayout(title string) {
    <!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="description" content="gin templ htmx hyperscript boilerplate"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
			<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
			<link rel="stylesheet" href="/static/styles/index.css"/>
			<script src="/static/scripts/htmx.min.js"></script>
		</head>
		<body class="subpixel-antialiased flex flex-col items-stretch text-gray-600 h-dvh overflow-hidden bg-slate-100 mih-h-0">
			{ children... }
		</body>
	</html>
}
